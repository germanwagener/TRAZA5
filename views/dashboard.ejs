<%- include('partials/head',{title:'Panel · TRAZA5'}) %>
<%- include('partials/nav') %>
<main>
  <%- include('partials/flash') %>
  <div class="pagehead">
    <div>
      <p class="eyebrow">EMPRESA ACTIVA</p>
      <h1><%= activeClient.name %></h1>
      <p class="muted">Materia prima → subproductos → productos intermedios → producto terminado, sin perder el origen de cada lote.</p>
    </div>
  </div>

  <section class="stats">
    <% Object.entries(stats).forEach(([key,value])=>{ %>
      <div class="card stat"><b><%= value %></b><span><%= key %></span></div>
    <% }) %>
  </section>

  <section class="card">
    <h2><%= sectors.length %> <%= sectors.length===1?'sector editable':'sectores editables' %></h2>
    <% if(sectors.length){ %>
      <div class="sectors" style="--sector-count:<%= Math.min(sectors.length,5) %>">
        <% sectors.forEach(s=>{ %><div><span><%= s.name %></span></div><% }) %>
      </div>
    <% } else { %>
      <p class="notice">Esta empresa todavía no tiene sectores activos. Un administrador puede agregarlos desde Maestros.</p>
    <% } %>
    <p class="muted">Un subproducto elaborado en cualquier sector puede utilizarse como ingrediente de una receta de otro sector de esta misma empresa.</p>
  </section>

  <section class="card">
    <div class="tablehead">
      <div>
        <h2>Últimas elaboraciones</h2>
        <p class="muted">Lote interno + lote final + estado.</p>
      </div>
      <a class="btn secondary" href="/trace">Ejercicio de trazabilidad</a>
    </div>
    <div class="tablewrap">
      <table>
        <thead><tr><th>Fecha</th><th>Sector</th><th>Producto</th><th>Lote interno</th><th>Lote final</th><th>Cant.</th><th>Estado</th></tr></thead>
        <tbody>
          <% if(!recent.length){ %><tr><td colspan="7">Todavía no hay elaboraciones.</td></tr><% } %>
          <% recent.forEach(r=>{ %>
            <tr>
              <td><%= new Date(r.produced_at).toLocaleString('es-AR') %></td>
              <td><%= r.sector %></td>
              <td><b><%= r.product %></b></td>
              <td><code><%= r.internal_lot %></code></td>
              <td><code><%= r.final_lot||'' %></code></td>
              <td><%= r.qty %></td>
              <td><span class="pill <%= r.status.toLowerCase() %>"><%= r.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
<%- include('partials/foot') %>

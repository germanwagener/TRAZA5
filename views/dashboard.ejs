<%- include('partials/head',{title:'Panel · TRAZA5'}) %><%- include('partials/nav') %><main><%- include('partials/flash') %><div class="pagehead"><div><p class="eyebrow">OPERACIÓN EN TIEMPO REAL</p><h1>Panel de control</h1><p class="muted">Materia prima → subproductos → productos intermedios → producto terminado, sin perder el origen de cada lote.</p></div></div><section class="stats"><% Object.entries(stats).forEach(([k,v])=>{ %><div class="card stat"><b><%= v %></b><span><%= k %></span></div><% }) %></section><section class="card"><h2>5 sectores editables</h2><div class="sectors"><% sectors.forEach(s=>{ %><div><span><%= s.name %></span></div><% }) %></div><p class="muted">Un subproducto elaborado en cualquier sector puede utilizarse como ingrediente de una receta de cualquier otro sector.</p></section><section class="card"><div class="tablehead"><div><h2>Últimas elaboraciones</h2><p class="muted">Lote interno + lote final + estado.</p></div><a class="btn secondary" href="/trace">Ejercicio de trazabilidad</a></div><div class="tablewrap"><table><thead><tr><th>Fecha</th><th>Sector</th><th>Producto</th><th>Lote interno</th><th>Lote final</th><th>Cant.</th><th>Estado</th></tr></thead><tbody><% if(!recent.length){ %><tr><td colspan="7">Todavía no hay elaboraciones.</td></tr><% } %><% recent.forEach(r=>{ %><tr><td><%= new Date(r.produced_at).toLocaleString('es-AR') %></td><td><%= r.sector %></td><td><b><%= r.product %></b></td><td><code><%= r.internal_lot %></code></td><td><code><%= r.final_lot||'' %></code></td><td><%= r.qty %></td><td><span class="pill <%= r.status.toLowerCase() %>"><%= r.status %></span></td></tr><% }) %></tbody></table></div></section></main><%- include('partials/foot') %>

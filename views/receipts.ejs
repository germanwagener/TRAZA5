<%- include('partials/head',{title:'Ingreso · TRAZA5'}) %>
<%- include('partials/nav') %>
<main>
  <%- include('partials/flash') %>
  <div class="pagehead">
    <div>
      <p class="eyebrow">RECEPCIÓN · <%= activeClient.name.toUpperCase() %></p>
      <h1>Ingreso de mercadería</h1>
      <p class="muted">La mercadería ingresa automáticamente al stock único de esta empresa, disponible para todos sus sectores sin transferencias. TRAZA5 convierte las presentaciones a la unidad de consumo.</p>
    </div>
  </div>

  <section class="card no-print">
    <form method="post" action="/receipts">
      <div class="formgrid">
        <label class="wide select-search-label">Buscar producto
          <input data-select-filter="receiptProduct" placeholder="Escribí parte del nombre, categoría o proveedor..." autocomplete="off">
        </label>
        <label>Producto
          <select id="receiptProduct" name="product_id" required>
            <option value="">Seleccionar...</option>
            <% products.forEach(p=>{ %>
              <option
                value="<%= p.id %>"
                data-brand="<%= p.default_brand||'' %>"
                data-unit="<%= p.unit %>"
                data-suppliers="<%= (p.supplier_ids||[]).join(',') %>"
                data-presentation-unit="<%= p.default_presentation_unit %>"
                data-content-per-presentation="<%= p.default_content_per_presentation %>"
                data-content-unit="<%= p.default_content_unit %>"
                data-presentations="<%= encodeURIComponent(JSON.stringify(p.supplier_configs||[])) %>"
              ><%= p.name %> · <%= p.category %><%= p.supplier_names?' · '+p.supplier_names:'' %></option>
            <% }) %>
          </select>
        </label>
        <label>Proveedor
          <select id="receiptSupplier" name="supplier_id" required>
            <option value="">Primero seleccioná el producto...</option>
            <% suppliers.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
          </select>
          <small id="supplierHint">El proveedor se completará automáticamente cuando exista una sola opción.</small>
        </label>
        <label>Marca<input id="receiptBrand" name="brand"></label>
        <label>Lote del proveedor<input name="supplier_lot"></label>
      </div>

      <fieldset class="presentation-box receipt-presentation">
        <legend>Presentación recibida</legend>
        <div class="presentation-grid receipt-presentation-grid">
          <label>Cantidad recibida
            <input id="receiptPresentationQty" type="number" step="0.001" min="0.001" name="presentation_qty" required>
          </label>
          <label>Unidad / envase
            <select id="receiptPresentationUnit" name="presentation_unit" required>
              <option value="bidón">Bidón</option>
              <option value="bolsa">Bolsa</option>
              <option value="botella">Botella</option>
              <option value="caja">Caja</option>
              <option value="paquete">Paquete</option>
              <option value="lata">Lata</option>
              <option value="balde">Balde</option>
              <option value="cajón">Cajón</option>
              <option value="unidad">Unidad</option>
              <option value="kg">kg</option>
              <option value="g">g</option>
              <option value="L">L</option>
              <option value="ml">ml</option>
            </select>
          </label>
          <label>Contenido de cada envase
            <input id="receiptContentPerPresentation" type="number" step="0.001" min="0.001" name="content_per_presentation" required>
          </label>
          <label>Unidad del contenido
            <select id="receiptContentUnit" name="content_unit" required>
              <option value="kg">kg</option>
              <option value="g">g</option>
              <option value="L">L</option>
              <option value="ml">ml</option>
              <option value="unidad">unidad</option>
              <option value="feta">feta</option>
            </select>
          </label>
        </div>
        <div id="receiptTotalPreview" class="calculation-preview">Seleccioná un producto para calcular el stock disponible.</div>
      </fieldset>

      <div class="formgrid">
        <label>Precio por presentación<input type="number" step="0.01" min="0" name="unit_price" value="0"></label>
        <label>Fecha de ingreso<input type="date" name="received_at" required></label>
        <label>Fecha de vencimiento
          <input type="date" name="expires_at">
          <small>Si queda vacía y el producto tiene vida útil, se calcula sola.</small>
        </label>
        <label class="wide">Observaciones<textarea name="notes"></textarea></label>
      </div>
      <button>Registrar ingreso y generar lote interno</button>
    </form>
  </section>

  <div class="toolbar no-print print-controls" data-date-filter="receiptsTable">
    <label>Desde<input type="date" data-date-from></label>
    <label>Hasta<input type="date" data-date-to></label>
    <input class="filter" data-table="receiptsTable" placeholder="Buscar proveedor, producto, lote...">
    <button type="button" class="secondary" data-date-today>Hoy</button>
    <button type="button" class="secondary" data-date-clear>Ver todos</button>
    <button type="button" onclick="window.print()">Imprimir / Exportar PDF</button>
    <small>Para crear el PDF, elegí “Guardar como PDF” en la ventana de impresión.</small>
  </div>

  <section class="card printarea">
    <div class="tablehead">
      <div>
        <h2>Planilla de ingreso de mercadería</h2>
        <p class="muted print-filter-summary" data-print-summary="receiptsTable">Período: Todos los registros</p>
      </div>
    </div>
    <div class="tablewrap">
      <table id="receiptsTable">
        <thead><tr><th>Fecha</th><th>Proveedor</th><th>Producto</th><th>Marca</th><th>Lote prov.</th><th>Lote interno</th><th>Recibido</th><th>Equivale a stock</th><th>Precio / presentación</th><th>Venc.</th><th>Usuario</th><th>Observaciones</th></tr></thead>
        <tbody>
          <% rows.forEach(r=>{ %>
            <tr data-date="<%= r.received_at.toISOString?r.received_at.toISOString().slice(0,10):String(r.received_at).slice(0,10) %>">
              <td><%= r.received_at.toISOString?r.received_at.toISOString().slice(0,10):r.received_at %></td>
              <td><%= r.supplier %></td>
              <td><b><%= r.product %></b></td>
              <td><%= r.brand %></td>
              <td><code><%= r.supplier_lot %></code></td>
              <td><code><%= r.internal_lot %></code></td>
              <td><b><%= r.presentation_qty %> <%= r.presentation_unit %></b><small class="block"><%= r.content_per_presentation %> <%= r.content_unit %> cada uno</small></td>
              <td><b><%= r.qty %> <%= r.unit %></b></td>
              <td>$ <%= Number(r.unit_price||0).toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
              <td><%= r.expires_at?(r.expires_at.toISOString?r.expires_at.toISOString().slice(0,10):r.expires_at):'' %></td>
              <td><%= r.username %></td>
              <td><%= r.notes||'' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <script>document.querySelector('input[name=received_at]').value=new Date().toISOString().slice(0,10);</script>
</main>
<%- include('partials/foot') %>

<%- include('partials/head',{title:'Trazabilidad · TRAZA5'}) %><%- include('partials/nav') %><main><%- include('partials/flash') %><div class="pagehead"><div><p class="eyebrow">EJERCICIO DE TRAZABILIDAD</p><h1>Reconstrucción automática</h1><p class="muted">Elegí producto y lote. “Hacia atrás” encuentra todos los componentes y proveedores. “Hacia adelante” encuentra todos los lotes que consumieron el origen.</p></div></div><section class="card"><form method="get" action="/trace" class="traceform"><label>Producto<select name="product_id" required><option value="">Seleccionar producto...</option><% products.forEach(p=>{ %><option value="<%= p.id %>" <%= String(productId)===String(p.id)?'selected':'' %>><%= p.name %> · <%= p.category %></option><% }) %></select></label><label>Lote<input name="lot" value="<%= lot %>" placeholder="Interno o final" required></label><label>Sentido<select name="direction"><option value="back" <%= direction==='back'?'selected':'' %>>Hacia atrás · origen</option><option value="forward" <%= direction==='forward'?'selected':'' %>>Hacia adelante · destino</option></select></label><button>Buscar trazabilidad</button></form><% if(matches.length){ %><h3>Coincidencias</h3><div class="tablewrap"><table><thead><tr><th>Tipo</th><th>Lote</th><th>Fecha</th><th></th></tr></thead><tbody><% matches.forEach(m=>{ %><tr><td><%= m.type==='receipt'?'Ingreso':'Elaboración' %></td><td><code><%= m.lot %></code></td><td><%= m.date %></td><td><a class="btn small" href="/trace?product_id=<%= productId %>&lot=<%= encodeURIComponent(lot) %>&direction=<%= direction %>&type=<%= m.type %>&id=<%= m.id %>">Reconstruir</a></td></tr><% }) %></tbody></table></div><% } %></section><% if(tree){ %><section class="card printarea"><div class="tablehead"><div><h2>Árbol de trazabilidad</h2><p class="muted"><%= direction==='back'?'Origen completo del lote seleccionado':'Destino completo del lote seleccionado' %></p></div><button onclick="window.print()">Imprimir / Guardar PDF</button></div><% function renderNode(n,depth=0){ %><div class="trace-node" style="--depth:<%= depth %>"><div class="trace-main"><span class="node-type"><%= n.type==='receipt'?'INGRESO':'ELABORACIÓN' %></span><b><%= n.data.product %></b><code><%= n.data.internal_lot %></code><% if(n.data.final_lot){ %><code><%= n.data.final_lot %></code><% } %></div><div class="trace-meta"><% if(n.type==='receipt'){ %>Proveedor: <b><%= n.data.supplier %></b> · Ingreso: <%= n.data.received_at %> · Vencimiento: <%= n.data.expires_at||'—' %> · Lote proveedor: <%= n.data.supplier_lot||'—' %><% } else { %>Sector: <b><%= n.data.sector %></b> · Receta: <%= n.data.recipe %> v<%= n.data.recipe_version %> · Elaborado: <%= new Date(n.data.produced_at).toLocaleString('es-AR') %> · Estado: <%= n.data.status %><% } %><% if(n.consumed_qty){ %> · Cantidad utilizada: <b><%= n.consumed_qty %></b><% } %></div><% n.children.forEach(c=>renderNode(c,depth+1)); %></div><% } renderNode(tree); %></section><% } %></main><%- include('partials/foot') %>

<%- include('partials/head',{title:'Trazabilidad · TRAZA5'}) %>
<%- include('partials/nav') %>
<main>
  <%- include('partials/flash') %>
  <div class="pagehead">
    <div>
      <p class="eyebrow">EJERCICIO DE TRAZABILIDAD · <%= activeClient.name.toUpperCase() %></p>
      <h1>Reconstrucción automática</h1>
      <p class="muted">Elegí producto y lote. “Hacia atrás” encuentra todos los componentes y proveedores. “Hacia adelante” encuentra todos los lotes que consumieron el origen.</p>
    </div>
  </div>

  <section class="card no-print">
    <label class="select-search-label trace-product-search">Buscar producto
      <input data-select-filter="traceProduct" placeholder="Escribí parte del producto..." autocomplete="off">
    </label>
    <form method="get" action="/trace" class="traceform">
      <label>Producto
        <select id="traceProduct" name="product_id" required>
          <option value="">Seleccionar producto...</option>
          <% products.forEach(p=>{ %>
            <option value="<%= p.id %>" <%= String(productId)===String(p.id)?'selected':'' %>><%= p.name %> · <%= p.category %></option>
          <% }) %>
        </select>
      </label>
      <label>Lote<input name="lot" value="<%= lot %>" placeholder="Interno o final" required></label>
      <label>Sentido
        <select name="direction">
          <option value="back" <%= direction==='back'?'selected':'' %>>Hacia atrás · origen</option>
          <option value="forward" <%= direction==='forward'?'selected':'' %>>Hacia adelante · destino</option>
        </select>
      </label>
      <button>Buscar trazabilidad</button>
    </form>

    <% if(matches.length){ %>
      <h3>Coincidencias</h3>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Tipo</th><th>Lote</th><th>Fecha</th><th></th></tr></thead>
          <tbody>
            <% matches.forEach(m=>{ %>
              <tr>
                <td><%= m.type==='receipt'?'Ingreso':'Elaboración' %></td>
                <td><code><%= m.lot %></code></td>
                <td><%= m.date %></td>
                <td><a class="btn small" href="/trace?product_id=<%= productId %>&lot=<%= encodeURIComponent(lot) %>&direction=<%= direction %>&type=<%= m.type %>&id=<%= m.id %>">Reconstruir</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <% if(tree){ %>
    <section class="card printarea">
      <div class="tablehead">
        <div>
          <h2>Informe de trazabilidad</h2>
          <p class="muted"><%= direction==='back'?'Origen completo del lote seleccionado':'Destino completo del lote seleccionado' %></p>
          <p class="print-filter-summary">Producto: <b><%= tree.data.product %></b> · Lote consultado: <b><%= lot %></b> · Emitido: <%= new Date().toLocaleString('es-AR',{timeZone:'America/Argentina/Buenos_Aires'}) %></p>
        </div>
        <div class="no-print print-actions">
          <button type="button" onclick="window.print()">Imprimir / Exportar PDF</button>
          <small>Para crear el PDF, elegí “Guardar como PDF” en la ventana de impresión.</small>
        </div>
      </div>
      <%
        function renderNode(n,depth=0){
      %>
        <div class="trace-node" style="--depth:<%= depth %>">
          <div class="trace-main">
            <span class="node-type"><%= n.type==='receipt'?'INGRESO':'ELABORACIÓN' %></span>
            <b><%= n.data.product %></b>
            <code><%= n.data.internal_lot %></code>
            <% if(n.data.final_lot){ %><code><%= n.data.final_lot %></code><% } %>
          </div>
          <div class="trace-meta">
            <% if(n.type==='receipt'){ %>
              Proveedor: <b><%= n.data.supplier %></b> · Recibido: <b><%= n.data.presentation_qty %> <%= n.data.presentation_unit %></b> de <%= n.data.content_per_presentation %> <%= n.data.content_unit %> cada uno · Stock: <b><%= n.data.qty %> <%= n.data.unit %></b> · Ingreso: <%= n.data.received_at %> · Vencimiento: <%= n.data.expires_at||'—' %> · Lote proveedor: <%= n.data.supplier_lot||'—' %>
            <% } else { %>
              Sector: <b><%= n.data.sector %></b> · Receta: <%= n.data.recipe %> v<%= n.data.recipe_version %><% if(n.data.production_group){ %> · Producción dividida: <code><%= n.data.production_group %></code><% } %> · Elaborado: <%= new Date(n.data.produced_at).toLocaleString('es-AR',{timeZone:'America/Argentina/Buenos_Aires'}) %> · Estado: <%= n.data.status %>
            <% } %>
            <% if(n.consumed_qty){ %> · Cantidad utilizada: <b><%= n.consumed_qty %></b><% } %>
          </div>
          <% (n.children||[]).forEach(c=>renderNode(c,depth+1)); %>
        </div>
      <%
        }
        renderNode(tree);
      %>
    </section>
  <% } %>
</main>
<%- include('partials/foot') %>

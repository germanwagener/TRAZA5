<%- include('partials/head',{title:'Recetas · TRAZA5'}) %>
<%- include('partials/nav') %>
<main>
  <%- include('partials/flash') %>
  <div class="pagehead">
    <div>
      <p class="eyebrow">FORMULACIÓN MAESTRA · <%= activeClient.name.toUpperCase() %></p>
      <h1>Recetas por sector</h1>
      <p class="muted">Una receta puede consumir materias primas o productos intermedios de esta empresa. Las recetas de otros clientes nunca aparecen.</p>
    </div>
  </div>

  <section class="card">
    <form method="post" action="/admin/recipes">
      <div class="formgrid">
        <label>Nombre de receta<input name="name" required></label>
        <label>Sector
          <select name="sector_id" required><% sectors.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select>
        </label>
        <label class="select-search-label">Buscar producto resultante
          <input data-select-filter="recipeOutputProduct" placeholder="Escribí parte del nombre..." autocomplete="off">
        </label>
        <label>Producto resultante
          <select id="recipeOutputProduct" name="output_product_id" required>
            <% products.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> · <%= p.category %><%= p.supplier_names?' · '+p.supplier_names:'' %></option><% }) %>
          </select>
        </label>
        <label>Rendimiento nominal<input type="number" step="0.001" min="0.001" name="output_qty" value="1" required></label>
        <label>Versión<input name="version" value="1.0" required></label>
        <label class="wide">Notas<input name="notes"></label>
      </div>
      <h3>Ingredientes / componentes</h3>
      <div id="recipeItems">
        <div class="recipe-row">
          <select name="input_product_id">
            <% products.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> · <%= p.unit %><%= p.supplier_names?' · '+p.supplier_names:'' %></option><% }) %>
          </select>
          <input type="number" step="0.001" min="0" name="input_qty" placeholder="Cantidad">
        </div>
      </div>
      <button type="button" class="secondary" id="addRecipeItem">+ Agregar ingrediente</button>
      <button>Guardar receta</button>
    </form>
  </section>

  <section class="card">
    <div class="tablehead">
      <div>
        <h2>Recetas cargadas</h2>
        <p class="muted">Para conservar el historial, una receta usada no se borra: se desactiva y se crea una versión nueva.</p>
      </div>
      <input class="filter" data-table="recipesTable" placeholder="Buscar receta, sector o producto...">
    </div>
    <div class="tablewrap">
      <table id="recipesTable">
        <thead><tr><th>Sector</th><th>Receta</th><th>Versión</th><th>Resultado</th><th>Rendimiento</th><th>Estado</th><th></th></tr></thead>
        <tbody>
          <% recipes.forEach(r=>{ %>
            <tr class="<%= r.active?'':'is-inactive' %>">
              <td><%= r.sector %></td>
              <td><b><%= r.name %></b><% if(r.notes){ %><small class="block"><%= r.notes %></small><% } %></td>
              <td><%= r.version %></td>
              <td><%= r.output_product %></td>
              <td><%= r.output_qty %></td>
              <td><span class="pill <%= r.active?'liberado':'rechazado' %>"><%= r.active?'ACTIVA':'INACTIVA' %></span></td>
              <td>
                <form method="post" action="/admin/recipes/<%= r.id %>/toggle">
                  <button class="small secondary"><%= r.active?'Desactivar':'Activar' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <script>window.TRAZA_PRODUCTS=<%- JSON.stringify(products) %>;</script>
</main>
<%- include('partials/foot') %>

<%- include('partials/head',{title:'Elaboración · TRAZA5'}) %>
<%- include('partials/nav') %>
<main>
  <%- include('partials/flash') %>
  <div class="pagehead">
    <div>
      <p class="eyebrow">PRODUCCIÓN · <%= activeClient.name.toUpperCase() %></p>
      <h1>Registrar elaboración</h1>
      <p class="muted">Todos los sectores utilizan el mismo stock de su empresa, sin transferencias. Elegí la receta y las cantidades: el sistema muestra lotes disponibles de cualquier sector de esta empresa y controla el saldo antes de grabar.</p>
    </div>
    <a class="btn secondary" href="/reports">Ver, imprimir o exportar planillas</a>
  </div>

  <section class="card">
    <form method="post" action="/production" id="productionForm">
      <div class="formgrid">
        <label class="wide select-search-label">Buscar receta
          <input data-select-filter="prodRecipe" placeholder="Escribí receta, sector o producto final..." autocomplete="off">
        </label>
        <label>Receta
          <select id="prodRecipe" name="recipe_id" required>
            <option value="">Seleccionar receta...</option>
            <% recipes.forEach(r=>{ %>
              <option value="<%= r.id %>"><%= r.sector %> · <%= r.name %> v<%= r.version %> → <%= r.output_product %><%= r.secondary_output_product ? ' + ' + r.secondary_output_product : '' %></option>
            <% }) %>
          </select>
        </label>
        <label>Fecha y hora de elaboración<input type="datetime-local" name="produced_at" required></label>
        <label id="singleOutputField">Cantidad producida<input type="number" step="0.001" min="0.001" name="output_qty" required></label>
        <div id="splitOutputFields" class="wide production-output-grid" hidden>
          <label>Cantidad de <span id="primaryOutputName">producto 1</span><input type="number" step="0.001" min="0.001" name="primary_output_qty"></label>
          <label>Cantidad de <span id="secondaryOutputName">producto 2</span><input type="number" step="0.001" min="0.001" name="secondary_output_qty"></label>
        </div>
        <label>Lote final<input name="final_lot" placeholder="Opcional; se genera automáticamente"><small>En una producción dividida se crearán dos lotes relacionados terminados en -1 y -2.</small></label>
        <label class="wide">Observaciones<textarea name="notes"></textarea></label>
      </div>
      <div id="recipeSummary" class="notice">Seleccioná una receta.</div>
      <h2>Lotes utilizados</h2>
      <p class="muted">Para cada ingrediente seleccioná uno o más lotes. Podés agregar filas si una receta consume dos lotes del mismo producto.</p>
      <div id="sourceRows"></div>
      <button type="button" id="addSourceManual" class="secondary">+ Agregar otra fila de lote</button>
      <button>Registrar elaboración</button>
    </form>
  </section>
  <script>document.querySelector('input[name=produced_at]').value=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,16);</script>
</main>
<%- include('partials/foot') %>

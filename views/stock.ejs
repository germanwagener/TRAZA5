<%- include('partials/head',{title:'Stock por lote · TRAZA5'}) %><%- include('partials/nav') %><main><%- include('partials/flash') %><div class="pagehead"><div><p class="eyebrow">INVENTARIO TRAZABLE</p><h1>Stock disponible por lote</h1><p class="muted">Cantidad original − consumos registrados = saldo disponible. Los lotes elaborados pueden bloquearse o rechazarse por el administrador.</p></div></div><div class="toolbar"><input class="filter" data-table="stockTable" placeholder="Buscar producto, lote, origen, estado..."><button onclick="window.print()">Imprimir</button></div><section class="card printarea"><div class="tablewrap"><table id="stockTable"><thead><tr><th>Origen</th><th>Producto</th><th>Tipo</th><th>Lote interno</th><th>Lote final</th><th>Fecha</th><th>Venc.</th><th>Inicial</th><th>Consumido</th><th>Disponible</th><th>Estado</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr class="<%= Number(r.available)<=0?'zero':'' %>"><td><%= r.origin %><small class="block"><%= r.kind %></small></td><td><b><%= r.product %></b><small class="block"><%= r.category %></small></td><td><%= r.kind %></td><td><code><%= r.lot %></code></td><td><code><%= r.final_lot||'' %></code></td><td><%= r.date %></td><td><%= r.expires||'' %></td><td><%= r.original_qty %> <%= r.unit %></td><td><%= r.consumed %> <%= r.unit %></td><td><b><%= r.available %> <%= r.unit %></b></td><td><span class="pill <%= r.status.toLowerCase() %>"><%= r.status %></span><% if(user.role==='admin' && r.kind==='Elaborado'){ %><form method="post" action="/admin/batches/<%= r.id %>/status" class="statusform no-print"><select name="status"><option <%= r.status==='LIBERADO'?'selected':'' %>>LIBERADO</option><option <%= r.status==='BLOQUEADO'?'selected':'' %>>BLOQUEADO</option><option <%= r.status==='RECHAZADO'?'selected':'' %>>RECHAZADO</option></select><button class="small">Guardar</button></form><% } %></td></tr><% }) %></tbody></table></div></section></main><%- include('partials/foot') %>

<%- include('partials/head',{title:'Ingreso · TRAZA5'}) %>
<main class="login-wrap">
  <%- include('partials/flash') %>
  <section class="card login">
    <div class="login-brand">
      <img src="/brand-logo.png" alt="">
      <div>
        <p class="company-name">Consultora en Alimentos</p>
        <p class="system-name">TRAZA5</p>
      </div>
    </div>
    <p class="eyebrow">SISTEMA INTEGRAL DE TRAZABILIDAD</p>
    <h1>Ingreso seguro</h1>
    <form method="post" action="/login">
      <label>Usuario<input name="username" autocomplete="username" required autofocus></label>
      <label>Contraseña<input type="password" name="password" autocomplete="current-password" required></label>
      <button>Ingresar</button>
    </form>
  </section>
</main>
<%- include('partials/foot') %>

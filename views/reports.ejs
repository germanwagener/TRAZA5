<%- include('partials/head',{title:'Planillas · TRAZA5'}) %><%- include('partials/nav') %><main><div class="pagehead"><div><p class="eyebrow">DOCUMENTACIÓN</p><h1>Planillas de elaboración</h1><p class="muted">Filtrá antes de imprimir. El navegador permite imprimir o guardar directamente como PDF.</p></div></div><div class="toolbar no-print"><input class="filter" data-table="reportsTable" placeholder="Filtrar por lote, producto, sector, receta, usuario..."><button onclick="window.print()">Imprimir / Guardar PDF</button></div><section class="card printarea"><div class="tablewrap"><table id="reportsTable"><thead><tr><th>Fecha</th><th>Sector</th><th>Receta</th><th>Producto</th><th>Lote interno</th><th>Lote final</th><th>Cantidad</th><th>Estado</th><th>Usuario</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= new Date(r.produced_at).toLocaleString('es-AR') %></td><td><%= r.sector %></td><td><%= r.recipe %> v<%= r.version %></td><td><b><%= r.product %></b></td><td><code><%= r.internal_lot %></code></td><td><code><%= r.final_lot||'' %></code></td><td><%= r.qty %></td><td><span class="pill <%= r.status.toLowerCase() %>"><%= r.status %></span><% if(user.role==='admin'){ %><form method="post" action="/admin/batches/<%= r.id %>/status" class="statusform no-print"><select name="status"><option>LIBERADO</option><option>BLOQUEADO</option><option>RECHAZADO</option></select><button class="small">Cambiar</button></form><% } %></td><td><%= r.username %></td></tr><% }) %></tbody></table></div></section></main><%- include('partials/foot') %>

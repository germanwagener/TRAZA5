<%- include('partials/head',{title:'Auditoría · TRAZA5'}) %><%- include('partials/nav') %><main><div class="pagehead"><div><p class="eyebrow">CONTROL DE CAMBIOS</p><h1>Auditoría</h1><p class="muted">Registro de acciones administrativas y operativas relevantes.</p></div></div><section class="card"><div class="tablehead"><h2>Últimos movimientos</h2><input class="filter" data-table="auditTable" placeholder="Filtrar..."></div><div class="tablewrap"><table id="auditTable"><thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>ID</th><th>Detalle</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= new Date(r.created_at).toLocaleString('es-AR') %></td><td><%= r.username||'Sistema' %></td><td><%= r.action %></td><td><%= r.entity_type %></td><td><%= r.entity_id||'' %></td><td><code><%= JSON.stringify(r.details) %></code></td></tr><% }) %></tbody></table></div></section></main><%- include('partials/foot') %>

<%- include('partials/head',{title:'Usuarios · TRAZA5'}) %><%- include('partials/nav') %><main><%- include('partials/flash') %><div class="pagehead"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Usuarios y contraseñas</h1><p class="muted">El administrador configura. Los operadores cargan cantidades, ingresos y elaboraciones.</p></div></div><div class="split"><section class="card"><h2>Crear usuario</h2><form method="post" action="/admin/users"><label>Usuario<input name="username" required></label><label>Contraseña inicial<input type="password" name="password" minlength="6" required></label><label>Rol<select name="role"><option value="operator">Operador</option><option value="admin">Administrador</option></select></label><button>Crear usuario</button></form></section><section class="card"><h2>Usuarios existentes</h2><div class="tablewrap"><table><thead><tr><th>Usuario</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><b><%= r.username %></b></td><td><%= r.role==='admin'?'Administrador':'Operador' %></td><td><span class="pill <%= r.active?'liberado':'rechazado' %>"><%= r.active?'ACTIVO':'INACTIVO' %></span></td><td><% if(Number(r.id)!==Number(user.id)){ %><form method="post" action="/admin/users/<%= r.id %>/toggle"><button class="small secondary"><%= r.active?'Desactivar':'Activar' %></button></form><% } %></td></tr><% }) %></tbody></table></div></section></div></main><%- include('partials/foot') %>

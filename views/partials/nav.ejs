<% if(user){ %>
<header class="app-header">
  <a class="brand-lockup" href="/" aria-label="Consultora en Alimentos · TRAZA5">
    <img class="brand-logo" src="/brand-logo.png" alt="">
    <span class="brand-copy">
      <strong>Consultora en Alimentos</strong>
      <small>TRAZA5 · SISTEMA DE TRAZABILIDAD</small>
    </span>
  </a>
  <nav aria-label="Navegación principal">
    <a href="/">Inicio</a>
    <a href="/receipts">Ingreso</a>
    <a href="/production">Elaboración</a>
    <a href="/stock">Stock por lote</a>
    <a href="/trace">Trazabilidad</a>
    <a href="/reports">Planillas</a>
    <% if(user.role==='superadmin'){ %>
      <a href="/admin/clients">Clientes</a>
    <% } %>
    <% if(user.role==='superadmin' || user.role==='admin'){ %>
      <a href="/admin/masters">Maestros</a>
      <a href="/admin/recipes">Recetas</a>
      <a href="/admin/users">Usuarios</a>
      <a href="/audit">Auditoría</a>
    <% } %>
    <a href="/account/password">Contraseña</a>
    <form method="post" action="/logout" class="inline"><button class="navbtn">Salir</button></form>
  </nav>
  <div class="session-context">
    <% if(user.role==='superadmin' && clientChoices.length){ %>
      <form method="post" action="/admin/client-context" class="client-switcher">
        <span>Empresa activa</span>
        <select name="client_id" onchange="this.form.submit()" aria-label="Empresa activa">
          <% clientChoices.forEach(c=>{ %>
            <option value="<%= c.id %>" <%= activeClient && Number(activeClient.id)===Number(c.id)?'selected':'' %>><%= c.name %></option>
          <% }) %>
        </select>
      </form>
    <% } else if(activeClient){ %>
      <div class="client-badge"><span>Empresa</span><b><%= activeClient.name %></b></div>
    <% } %>
    <div class="who">
      <b><%= user.username %></b>
      <span><%= user.role==='superadmin'?'Administración general':(user.role==='admin'?'Administrador de empresa':'Operador') %></span>
    </div>
  </div>
</header>
<div class="print-brand" aria-hidden="true">
  <img src="/brand-logo.png" alt="">
  <div>
    <strong>Consultora en Alimentos</strong>
    <span>TRAZA5 · <%= activeClient ? activeClient.name : 'Sistema integral de trazabilidad' %></span>
  </div>
</div>
<% } %>
